[gd_resource type="StandardMaterial3D" format=3]

; Birch canopy.
; Written by hand: the Synty source uses Unity shaders (wind, triplanar, tree cards)
; that mean nothing to Godot, so each material slot in the pack gets a plain Godot
; equivalent here. Wind is a vertex shader applied separately - see wind_sway.gdshader.

[ext_resource type="Texture2D" path="res://assets/Synty/PolygonMeadow/Textures/treeBirch_01.png" id="1_tex"]

[resource]
resource_name = "meadow_birch"
albedo_texture = ExtResource("1_tex")
roughness = 0.85
metallic_specular = 0.0
specular_mode = 1
uv1_scale = Vector3(1, 1, 0)
; The canopy is solid geometry unwrapped across this whole sheet, and the sheet's
; background is transparent white. Rendered opaque, every leaf-quad edge that
; touches that background shows up as a white speck; scissored at 0.4 the leaves
; themselves get cut away and the tree goes bald. 0.12 removes the background and
; keeps the foliage - see tools/compare_tree_materials.gd, which is the test that
; settled it.
transparency = 2
alpha_scissor_threshold = 0.12
cull_mode = 2
